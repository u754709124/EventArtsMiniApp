# EventArtsMiniApp production reverse proxy template.
# Replace server_name and TLS settings for the target server before enabling.
# API/Admin upstreams must stay on loopback; do not expose their ports publicly.

upstream eventarts_admin {
    # Internal Admin static service only. Keep ADMIN_HOST loopback in production.
    server 127.0.0.1:4173;
    keepalive 16;
}

upstream eventarts_api {
    # Internal Fastify API service only. Keep API_HOST loopback in production.
    server 127.0.0.1:3001;
    keepalive 16;
}

# TLS/HSTS guardrail:
# - Do not uncomment these lines with placeholder paths.
# - Install real certificates first, then move this server to listen 443 ssl http2.
# - HSTS is only safe after HTTPS works for the final production domain.
#
# listen 443 ssl http2;
# ssl_certificate /etc/letsencrypt/live/your-domain.example/fullchain.pem;
# ssl_certificate_key /etc/letsencrypt/live/your-domain.example/privkey.pem;
# add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

server {
    listen 80;
    server_name _;
    server_tokens off;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    # Keep this above the API video upload limit. Default API example is 100 MiB.
    client_max_body_size 120m;

    proxy_connect_timeout 15s;
    proxy_send_timeout 120s;
    proxy_read_timeout 120s;

    location = /admin {
        return 308 /admin/;
    }

    location ^~ /admin/assets/ {
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000, immutable";
        proxy_pass http://eventarts_admin;
    }

    location ^~ /admin/ {
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_pass http://eventarts_admin;
    }

    location ^~ /api/ {
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_pass http://eventarts_api;
    }

    location ^~ /uploads/ {
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        expires 7d;
        add_header Cache-Control "public, max-age=604800";
        proxy_pass http://eventarts_api;
    }

    location / {
        return 404;
    }
}
