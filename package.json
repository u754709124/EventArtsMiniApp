{
  "name": "event-arts-miniapp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "dev:api": "pnpm --filter api dev",
    "dev:admin": "pnpm --filter admin dev",
    "dev:h5": "pnpm --filter miniapp dev:h5",
    "build:api": "pnpm --filter api build",
    "build:admin": "pnpm --filter admin build",
    "build:h5": "pnpm --filter miniapp build:h5",
    "build:weapp": "pnpm --filter miniapp build:weapp",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "test": "pnpm -r --if-present test",
    "e2e": "playwright test",
    "db:push": "pnpm --filter api db:push",
    "db:seed": "pnpm --filter api db:seed",
    "assets:slice": "tsx scripts/slice-home-assets.ts",
    "assets:slice:artists": "tsx scripts/slice-artist-assets.ts",
    "release:check": "pnpm lint && pnpm test && pnpm e2e && pnpm --filter api build && pnpm --filter admin build && pnpm --filter miniapp build:h5 && pnpm build:weapp"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.18.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "sharp": "^0.35.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0",
    "vitest": "^4.1.9"
  }
}
