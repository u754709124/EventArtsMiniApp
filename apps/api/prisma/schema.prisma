generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id            Int                 @id @default(autoincrement())
  username      String              @unique
  passwordHash  String
  status        String              @default("enabled")
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  sessions      AdminSession[]
  notifications AdminNotification[]

  @@map("admin_users")
}

model AdminNotification {
  id            Int       @id @default(autoincrement())
  adminId       Int
  clientEventId String
  level         String
  message       String
  occurredAt    DateTime
  createdAt     DateTime  @default(now())
  admin         AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([adminId, clientEventId])
  @@index([adminId, occurredAt])
  @@index([occurredAt])
  @@map("admin_notifications")
}

model AdminSession {
  jti          String    @id
  adminId      Int
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  revokeReason String?
  admin        AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("admin_sessions")
}

model ClientSession {
  id           String    @id @default(uuid())
  tokenHash    String    @unique
  appId        String
  openidHash   String
  unionidHash  String?
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  revokeReason String?
  lastSeenAt   DateTime?

  @@index([openidHash])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("client_sessions")
}

model SiteConfig {
  id                       Int        @id @default(1)
  appName                  String
  subtitle                 String
  defaultBannerAssetId     Int?
  placeholderBannerAssetId Int?
  placeholderIconAssetId   Int?
  placeholderCaseAssetId   Int?
  updatedAt                DateTime   @updatedAt
  defaultBannerAsset       MediaAsset? @relation("defaultBanner", fields: [defaultBannerAssetId], references: [id])
  placeholderBannerAsset   MediaAsset? @relation("placeholderBanner", fields: [placeholderBannerAssetId], references: [id])
  placeholderIconAsset     MediaAsset? @relation("placeholderIcon", fields: [placeholderIconAssetId], references: [id])
  placeholderCaseAsset     MediaAsset? @relation("placeholderCase", fields: [placeholderCaseAssetId], references: [id])

  @@map("site_config")
}

model SystemConfig {
  id                  Int      @id @default(1)
  zoneId              String
  secretIdCiphertext  String
  secretKeyCiphertext String
  updatedAt           DateTime @updatedAt

  @@map("system_config")
}

model MediaAsset {
  id                       Int            @id @default(autoincrement())
  resourceName             String
  resourceNameKey          String         @unique
  originalName             String
  filename                 String         @unique
  md5                      String         @unique
  mimeType                 String
  mediaType                String
  legacyUsage              String         @default("legacy") @map("usage")
  url                      String
  width                    Int?
  height                   Int?
  size                     Int
  storageType              String         @default("local")
  createdBy                Int?
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt
  tags                     MediaAssetTag[]
  caseDetailMedia          ActivityCaseMedia[]
  detailPageBanners        DetailPageBannerMedia[]
  detailPageContentMedia   DetailPageContentMedia[]
  banners                  Banner[]
  menuItems                MenuItem[]
  artists                  Artist[]
  activityCases            ActivityCase[]
  articles                 Article[]
  defaultBannerConfigs     SiteConfig[]   @relation("defaultBanner")
  placeholderBannerConfigs SiteConfig[]   @relation("placeholderBanner")
  placeholderIconConfigs   SiteConfig[]   @relation("placeholderIcon")
  placeholderCaseConfigs   SiteConfig[]   @relation("placeholderCase")

  @@map("media_assets")
}

model MediaAssetTag {
  id           Int        @id @default(autoincrement())
  mediaAssetId Int
  label        String
  labelKey     String
  mediaAsset   MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@unique([mediaAssetId, labelKey])
  @@index([labelKey])
  @@map("media_asset_tags")
}

model Announcement {
  id                Int      @id @default(autoincrement())
  summary           String
  content           String
  displayDurationMs Int
  detailPageId      Int?
  detailPage        DetailPageConfig? @relation(fields: [detailPageId], references: [id], onDelete: Restrict)
  sortOrder         Int      @default(0)
  status            String   @default("enabled")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([detailPageId])
  @@map("announcements")
}

model Banner {
  id               Int        @id @default(autoincrement())
  title            String
  imageAssetId     Int
  imageAsset       MediaAsset @relation(fields: [imageAssetId], references: [id])
  linkType         String     @default("none")
  linkTarget       String?
  detailPageId     Int?
  detailPage       DetailPageConfig? @relation(fields: [detailPageId], references: [id], onDelete: Restrict)
  switchDurationMs Int
  sortOrder        Int        @default(0)
  status           String     @default("enabled")
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([detailPageId])
  @@map("banners")
}

model MenuItem {
  id          Int        @id @default(autoincrement())
  text        String
  iconAssetId Int
  iconAsset   MediaAsset @relation(fields: [iconAssetId], references: [id])
  type        String
  configJson  String
  showOnHome Boolean    @default(true)
  sortOrder   Int        @default(0)
  status      String     @default("enabled")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("menu_items")
}

model Artist {
  id            Int         @id @default(autoincrement())
  name          String
  type          String
  avatarAssetId Int?
  avatarAsset   MediaAsset? @relation(fields: [avatarAssetId], references: [id])
  location      String      @default("")
  badge         String      @default("")
  summary       String
  tagsJson      String
  detail        String
  detailPageId  Int?
  detailPage    DetailPageConfig? @relation(fields: [detailPageId], references: [id], onDelete: Restrict)
  sortOrder     Int         @default(0)
  status        String      @default("enabled")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([detailPageId])
  @@map("artists")
}

model ActivityCase {
  id                Int        @id @default(autoincrement())
  title             String
  category          String
  tag               String
  coverAssetId      Int
  coverAsset        MediaAsset @relation(fields: [coverAssetId], references: [id])
  summary           String
  eventDate         DateTime
  location          String
  detail            String
  detailPageId      Int?
  detailPage        DetailPageConfig? @relation(fields: [detailPageId], references: [id], onDelete: Restrict)
  legacyMediaJson   String      @default("[]") @map("mediaJson")
  media             ActivityCaseMedia[]
  isFeatured        Boolean    @default(false)
  featuredSortOrder Int        @default(0)
  sortOrder         Int        @default(0)
  status            String     @default("enabled")
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([detailPageId])
  @@map("activity_cases")
}

model Article {
  id                Int        @id @default(autoincrement())
  title             String
  category          String
  coverAssetId      Int
  coverAsset        MediaAsset @relation(fields: [coverAssetId], references: [id])
  summary           String
  publishedAt       DateTime
  isFeatured        Boolean    @default(false)
  featuredSortOrder Int        @default(0)
  sortOrder         Int        @default(0)
  status            String     @default("enabled")
  detailPageId      Int?
  detailPage        DetailPageConfig? @relation(fields: [detailPageId], references: [id], onDelete: Restrict)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([coverAssetId])
  @@index([detailPageId])
  @@index([category])
  @@index([status, sortOrder])
  @@index([status, isFeatured, featuredSortOrder])
  @@map("articles")
}

model ActivityCaseMedia {
  id             Int          @id @default(autoincrement())
  activityCaseId Int
  mediaAssetId   Int
  sortOrder      Int
  activityCase   ActivityCase @relation(fields: [activityCaseId], references: [id], onDelete: Cascade)
  mediaAsset     MediaAsset   @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@unique([activityCaseId, mediaAssetId])
  @@index([mediaAssetId])
  @@map("activity_case_media")
}

model DetailPageConfig {
  id            Int      @id @default(autoincrement())
  name          String
  ownerType     String?
  ownerId       Int?
  pageType      String
  heroTitle     String   @default("")
  heroTypeLabel String   @default("")
  heroSubtitle  String   @default("")
  heroBadge     String   @default("")
  heroTagsJson  String   @default("[]")
  heroLocation  String   @default("")
  heroMetaJson  String   @default("[]")
  richTextHtml  String   @default("")
  schemaVersion Int      @default(2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  banners       DetailPageBannerMedia[]
  contentMedia  DetailPageContentMedia[]
  announcements Announcement[]
  homeBanners   Banner[]
  artists       Artist[]
  activityCases ActivityCase[]
  articles      Article[]

  @@unique([ownerType, ownerId])
  @@index([name])
  @@index([pageType])
  @@index([ownerType])
  @@map("detail_page_configs")
}

model DetailPageBannerMedia {
  id                 Int @id @default(autoincrement())
  detailPageConfigId Int
  mediaAssetId       Int
  sortOrder          Int @default(0)

  detailPageConfig DetailPageConfig @relation(fields: [detailPageConfigId], references: [id], onDelete: Cascade)
  mediaAsset       MediaAsset       @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@unique([detailPageConfigId, mediaAssetId])
  @@index([detailPageConfigId, sortOrder])
  @@index([mediaAssetId])
  @@map("detail_page_banner_media")
}

model DetailPageContentMedia {
  id                 Int @id @default(autoincrement())
  detailPageConfigId Int
  mediaAssetId       Int

  detailPageConfig DetailPageConfig @relation(fields: [detailPageConfigId], references: [id], onDelete: Cascade)
  mediaAsset       MediaAsset       @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@unique([detailPageConfigId, mediaAssetId])
  @@index([mediaAssetId])
  @@map("detail_page_content_media")
}

model PageViewEvent {
  id                   Int      @id @default(autoincrement())
  pagePath             String
  scene                String?
  userAgent            String?
  anonymousFingerprint String   @default("")
  sampleWeight         Int      @default(1)
  createdAt            DateTime @default(now())

  @@index([createdAt])
  @@index([anonymousFingerprint, pagePath, scene, createdAt])
  @@map("page_view_events")
}

model DailyUserVisit {
  id         Int      @id @default(autoincrement())
  appId      String
  openidHash String
  visitDate  String
  createdAt  DateTime @default(now())

  @@unique([appId, openidHash, visitDate])
  @@index([visitDate])
  @@map("daily_user_visits")
}

model OperationLog {
  id        Int      @id @default(autoincrement())
  action    String
  detail    String?
  createdBy Int?
  createdAt DateTime @default(now())

  @@map("operation_logs")
}

model SeedRecord {
  key        String   @id
  entityType String
  entityId   Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("seed_records")
}
