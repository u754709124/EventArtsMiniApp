{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx src/server.ts",
    "prebuild": "prisma generate --schema prisma/schema.prisma",
    "build": "tsc -p tsconfig.json --noEmit",
    "pretest": "prisma generate --schema prisma/schema.prisma",
    "test": "vitest run",
    "db:push": "prisma generate --schema prisma/schema.prisma && node --import tsx src/bootstrap-db.ts",
    "db:seed": "node --import tsx prisma/seed.ts",
    "admin:bootstrap": "node --import tsx src/admin-bootstrap.ts",
    "admin:sessions:cleanup": "node --import tsx src/admin-sessions.ts",
    "analytics:cleanup": "node --import tsx src/analytics.ts",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@event-arts/shared": "workspace:*",
    "@fastify/cors": "^11.2.0",
    "@fastify/jwt": "^10.1.0",
    "@fastify/multipart": "^9.3.0",
    "@fastify/static": "^8.3.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@prisma/client": "^6.19.0",
    "fastify": "^5.9.0",
    "parse5": "^8.0.1",
    "sanitize-html": "^2.17.5",
    "sharp": "^0.35.3",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/sanitize-html": "^2.16.1",
    "prisma": "^6.19.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
