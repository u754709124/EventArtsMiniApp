# Copy this file to .env at the repository root.
# Values are placeholders or local defaults; generate real production secrets outside source control.

NODE_ENV=development

API_HOST=127.0.0.1
API_PORT=3001
ADMIN_HOST=127.0.0.1
ADMIN_PORT=4173

JWT_SECRET=<generate-a-strong-random-secret-with-at-least-32-characters>
# Generate with: openssl rand -base64 32
# Production requires one canonical Base64 value encoding exactly 32 bytes.
EDGEONE_CREDENTIAL_ENCRYPTION_KEY=
DATABASE_URL=file:./dev.db
UPLOAD_DIR=uploads
BACKUP_DIR=var/backups
PUBLIC_BASE_URL=http://127.0.0.1:3001

CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
CORS_ALLOW_REQUESTS_WITHOUT_ORIGIN=true

LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX_FAILURES=5
ANALYTICS_RATE_LIMIT_WINDOW_MS=60000
ANALYTICS_RATE_LIMIT_MAX_REQUESTS=60
PAGE_VIEW_RETENTION_DAYS=90

# Client miniapp authentication. Keep AppSecret only on the API host.
WECHAT_MINIAPP_APP_ID=
WECHAT_MINIAPP_APP_SECRET=
WECHAT_AUTH_VERIFIER_MODE=wechat
CLIENT_SESSION_TTL_SECONDS=1800
WECHAT_CODE2SESSION_TIMEOUT_MS=3000

MAX_IMAGE_UPLOAD_BYTES=10485760
MAX_VIDEO_UPLOAD_BYTES=104857600

VITE_API_BASE_URL=http://127.0.0.1:3001
TARO_APP_API_BASE_URL=http://127.0.0.1:3001

# Production same-origin Nginx deployment:
# NODE_ENV=production
# Keep API_HOST and ADMIN_HOST on loopback. Do not use 0.0.0.0 or public addresses.
# API_HOST=127.0.0.1
# ADMIN_HOST=127.0.0.1
# PUBLIC_BASE_URL=https://your-domain.example
# CORS_ALLOWED_ORIGINS=https://your-domain.example
# WECHAT_MINIAPP_APP_ID=
# WECHAT_MINIAPP_APP_SECRET=
# WECHAT_AUTH_VERIFIER_MODE=wechat
# VITE_API_BASE_URL=
# TARO_APP_API_BASE_URL=https://your-domain.example
